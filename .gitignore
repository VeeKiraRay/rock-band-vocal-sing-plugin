# CMake build output (regenerated by `cmake -B build`; includes the fetched
# JUCE source under build/_deps and the compiled .vst3 artefact).
# NOTE: the top-level cmake/ folder is NOT ignored — it holds CPM.cmake, which
# CMakeLists.txt includes to bootstrap dependency fetching, and must be committed.
/build/

# Common alternative build dir names
/cmake-build-*/
/out/

# IDE / editor
.vs/
.vscode/
.idea/
*.user

# OS cruft
.DS_Store
Thumbs.db
/_old
/_upcoming